<Window x:Class="Recorder.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" UseLayoutRounding="True">
    <Grid.Resources>
      <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/></Style>
      <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
      <DataTemplate x:Key="SentenceTemplate"><Grid Padding="4,10" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Timestamp}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono" Margin="0,3,0,0"/><TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="15" LineHeight="23" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Grid></DataTemplate>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Padding="24,16,24,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE720;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="课堂记录" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" x:Name="hideButton" Content="后台运行" FontSize="13" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="隐藏到系统托盘，继续记录" AutomationProperties.Name="后台运行，隐藏到系统托盘"/></Grid>
    <NavigationView x:Name="navigation" Grid.Row="1" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" AlwaysShowHeader="False" IsTitleBarAutoPaddingEnabled="False">
      <NavigationView.MenuItems><NavigationViewItem Content="记录" Tag="record"><NavigationViewItem.Icon><SymbolIcon Symbol="Microphone"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="历史" Tag="history"><NavigationViewItem.Icon><SymbolIcon Symbol="Document"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
      <Grid Margin="24,12,24,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <ScrollViewer MaxHeight="136" VerticalScrollBarVisibility="Auto"><InfoBar x:Name="info" IsOpen="False" IsClosable="True" Margin="0,0,0,10"/></ScrollViewer>
        <Grid x:Name="recordPage" Grid.Row="1" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid x:Name="inputGrid" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="course" Header="课程" PlaceholderText="输入课程名称"/><ComboBox x:Name="devices" Grid.Column="1" Header="麦克风" HorizontalAlignment="Stretch"/></Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="stateDot" Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="status" Grid.Column="1" Text="准备就绪" Style="{StaticResource Caption}"/><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="loading" Width="16" Height="16" IsActive="False" Visibility="Collapsed"/><TextBlock x:Name="elapsed" Text="00:00:00" FontSize="13" FontFamily="Cascadia Mono"/></StackPanel></Grid><ScrollViewer x:Name="partialScroll" Grid.Row="1" MaxHeight="81" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="partial" Text="点击“开始记录”开始录音。" FontSize="18" LineHeight="27" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer><Grid Grid.Row="2" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><TextBlock x:Name="partialHeading" Text="实时识别 · 自动保存完整句子" Style="{StaticResource Caption}"/><ProgressBar x:Name="volume" Grid.Column="1" Minimum="0" Maximum="1" Height="3" VerticalAlignment="Center" AutomationProperties.Name="麦克风音量"/></Grid></Grid></Border>
          <Grid x:Name="savedPanel" Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="已保存" FontWeight="SemiBold"/><TextBlock x:Name="savedCount" Text="0 句" Style="{StaticResource Caption}" VerticalAlignment="Center"/></StackPanel><Button x:Name="latestButton" Grid.Column="1" Content="回到最新" Style="{StaticResource SubtleButtonStyle}" FontSize="12"/></Grid>
            <Grid Grid.Row="1"><ListView x:Name="finalList" SelectionMode="None" ItemTemplate="{StaticResource SentenceTemplate}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled"/><StackPanel x:Name="emptyRecord" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="28"/><TextBlock Text="暂无记录" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="已保存的文字会显示在这里。" Style="{StaticResource Caption}"/></StackPanel></Grid>
          </Grid>
          <Grid Grid.Row="3" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="file" Text="每次课堂自动创建一份文本记录" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True"/><Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="start" Content="开始记录" Style="{StaticResource AccentButtonStyle}" MinWidth="112" IsEnabled="False"/><Button x:Name="stop" Content="停止并保存" MinWidth="112" Style="{StaticResource AccentButtonStyle}" IsEnabled="False" Visibility="Collapsed"/><Button x:Name="recover" Grid.Column="2" Content="另存待确认文字" Visibility="Collapsed" HorizontalAlignment="Left"/><Button x:Name="openFile" Grid.Column="3" Content="打开文本" IsEnabled="False" Style="{StaticResource SubtleButtonStyle}"/></Grid></Grid>
        </Grid>
        <Grid x:Name="historyPage" Grid.Row="1" Visibility="Collapsed" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="你的课堂" FontSize="22" FontWeight="SemiBold"/><Button x:Name="refreshHistory" Grid.Column="1" Content="刷新" Style="{StaticResource SubtleButtonStyle}"/><Button x:Name="openFolderButton" Grid.Column="2" Content="打开文件夹" Style="{StaticResource SubtleButtonStyle}"/></Grid><Grid Grid.Row="1"><ListView x:Name="history" IsItemClickEnabled="True" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Grid Padding="4,12" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8A5;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"/></StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"/></Grid></DataTemplate></ListView.ItemTemplate></ListView><StackPanel x:Name="emptyHistory" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"><TextBlock Text="暂无历史记录" FontSize="18"/><TextBlock Text="完成录音后，在这里重新打开。" Style="{StaticResource Caption}"/></StackPanel></Grid></Grid>
        <Grid x:Name="settingsPage" Grid.Row="1" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><TextBlock Text="设置" FontSize="22" FontWeight="SemiBold"/><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="记录" FontWeight="SemiBold"/><NumberBox x:Name="stability" Header="保存前等待（秒）" Minimum="0.5" Maximum="5" SmallChange="0.1" SpinButtonPlacementMode="Compact" HorizontalAlignment="Left" Width="160"/><TextBlock Text="等待文字稳定并出现停顿，再保存为完整句子。" TextWrapping="Wrap" Style="{StaticResource Caption}"/><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="folder" Header="保存位置" IsReadOnly="True"/><Button x:Name="chooseFolder" Grid.Column="1" Content="更改" VerticalAlignment="Bottom"/></Grid><TextBlock Text="录音期间更改位置，会在下一次课堂生效。" Style="{StaticResource Caption}"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="16"><ComboBox x:Name="theme" Header="外观" Width="180"/><ToggleSwitch x:Name="closeToTray" Header="关闭窗口后继续在后台运行" OnContent="隐藏到系统托盘" OffContent="保存记录并退出"/></StackPanel></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="本地英语识别 · Nemotron Streaming EN" TextWrapping="Wrap" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button x:Name="saveSettingsButton" Grid.Column="1" Content="保存设置"/></Grid></StackPanel></ScrollViewer></Grid>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
